	$(MAKE) $(MAKESILENT) -f CMakeFiles\test_runner.dir\build.make CMakeFiles/test_runner.dir/tests/unit/test_skiplist.cpp.i
.PHONY : tests/unit/test_skiplist.cpp.i

tests/unit/test_skiplist.s: tests/unit/test_skiplist.cpp.s
.PHONY : tests/unit/test_skiplist.s

# target to generate assembly for a file
tests/unit/test_skiplist.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\test_runner.dir\build.make CMakeFiles/test_runner.dir/tests/unit/test_skiplist.cpp.s
.PHONY : tests/unit/test_skiplist.cpp.s

